# ============================================================
# Smart POS - Production Environment Variables Template
# ============================================================
# Copy this file to .env.production or .env on your production server

NODE_ENV=production
PORT=3001

# ---- Database (PostgreSQL + PgBouncer) ----
POSTGRES_USER=smartpos_admin
POSTGRES_PASSWORD=generate_a_very_strong_password_here
POSTGRES_DB=smartpos_production
DATABASE_URL=postgresql://smartpos_admin:generate_a_very_strong_password_here@pgbouncer:6432/smartpos_production?sslmode=disable
DIRECT_DATABASE_URL=postgresql://smartpos_admin:generate_a_very_strong_password_here@postgres:5432/smartpos_production?sslmode=disable

# ---- Redis Cache & Event Bus ----
REDIS_PASSWORD=generate_a_strong_redis_password_here
REDIS_URL=redis://:generate_a_strong_redis_password_here@redis:6379

# ---- Authentication & Security ----
JWT_SECRET=generate_at_least_64_characters_random_string_here
JWT_REFRESH_SECRET=generate_another_64_characters_random_string_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
SESSION_SECRET=generate_session_random_string_here
BCRYPT_SALT_ROUNDS=12

# ---- CORS & Allowed Origins ----
CORS_ORIGIN=https://pos.yourdomain.com,http://localhost

# ---- Frontend Environment Variables ----
VITE_API_URL=/api/v1
VITE_WS_URL=wss://pos.yourdomain.com/ws
VITE_APP_NAME=Smart POS
VITE_DEFAULT_LANGUAGE=ar
VITE_DEFAULT_THEME=light

# ---- Monitoring (Prometheus & Grafana) ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_this_admin_password

# ---- Uploads & File Storage ----
UPLOAD_DIR=/app/uploads

# ---- Logging & Rate Limits ----
LOG_LEVEL=info
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
